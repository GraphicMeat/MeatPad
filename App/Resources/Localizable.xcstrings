    "%lld documents have unsaved changes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Dokumente haben nicht gesicherte Änderungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld documentos tienen cambios sin guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld documents ont des modifications non enregistrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld documenti presentano modifiche non salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld個の書類に未保存の変更があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서 %lld개에 저장되지 않은 변경 사항이 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld documentos têm alterações não salvas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 份文稿有未存储的更改。"
          }
        }
      }
    },
    "%lld files have unsaved edits and will be skipped.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Dateien haben nicht gesicherte Änderungen und werden übersprungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld archivos tienen modificaciones sin guardar y se omitirán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fichiers ont des modifications non enregistrées et seront ignorés."
