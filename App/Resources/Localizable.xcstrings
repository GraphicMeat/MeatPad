    "MeatPad's only network access. Off means no automatic background checks — Check for Updates… in the menu still works." : {
      "comment" : "A description of the network access that MeatPad has.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der einzige Netzwerkzugriff von MeatPad. Deaktiviert bedeutet keine automatischen Hintergrundprüfungen — Nach Updates suchen… im Menü funktioniert weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El único acceso de red de MeatPad. Desactivado significa que no hay comprobaciones automáticas en segundo plano — Buscar actualizaciones… en el menú sigue funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le seul accès réseau de MeatPad. Désactivé signifie aucune vérification automatique en arrière-plan — Rechercher les mises à jour… dans le menu fonctionne toujours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’unico accesso di rete di MeatPad. Disattivato significa nessun controllo automatico in background: Cerca aggiornamenti… nel menu funziona comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeatPadの唯一のネットワークアクセスです。オフにすると自動バックグラウンド確認は行われなくなりますが、メニューの「アップデートを確認…」は引き続き使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeatPad의 유일한 네트워크 액세스입니다. 끄면 자동 백그라운드 확인이 없어지지만, 메뉴의 업데이트 확인…은 계속 작동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O único acesso de rede do MeatPad. Desativado significa nenhuma verificação automática em segundo plano — Verificar Atualizações… no menu continua funcionando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeatPad 唯一的网络访问行为。关闭后将不会有自动后台检查——菜单中的“检查更新…”仍然可用。"
          }
        }
      }
    },
