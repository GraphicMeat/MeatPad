{
  "sourceLanguage" : "en",
  "strings" : {
    " — imported as untrusted; each will ask for confirmation before its first run" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " — als nicht vertrauenswürdig importiert; jeder fragt vor der ersten Ausführung um Bestätigung"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " — importados como no confiables; cada uno pedirá confirmación antes de su primera ejecución"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " — importées comme non approuvées ; chacune demandera une confirmation avant sa première exécution"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " — importati come non attendibili; ciascuno chiederà conferma prima della prima esecuzione"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "—未信頼としてインポートされ、それぞれ初回実行前に確認を求めます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " — 신뢰되지 않은 상태로 가져왔으며, 각각 처음 실행하기 전에 확인을 요청합니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " — importados como não confiáveis; cada um pedirá confirmação antes de sua primeira execução"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "——已作为不受信任内容导入，每项在首次运行前都会请求确认"
          }
        }
      }
    },
