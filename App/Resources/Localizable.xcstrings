            "value": "Eliminare “%@”? Le relative note verranno spostate nel cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”を削除しますか？ 中のノートはゴミ箱に移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”을(를) 삭제하시겠습니까? 메모가 휴지통으로 이동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar “%@”? As notas dela vão para o lixo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除“%@”吗？其中的笔记将移到废纸篓。"
          }
        }
      }
    },
