    "Network use is limited to update checks (Sparkle). See below for where your data lives." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Netzwerknutzung beschränkt sich auf Update-Prüfungen (Sparkle). Wo Ihre Daten liegen, erfahren Sie weiter unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El uso de red se limita a las comprobaciones de actualizaciones (Sparkle). Más abajo encontrarás dónde viven tus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’utilisation du réseau se limite aux vérifications de mise à jour (Sparkle). Voir ci-dessous où se trouvent vos données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
